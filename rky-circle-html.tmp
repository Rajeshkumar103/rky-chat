padding:16px;
border-radius:16px;
background:linear-gradient(135deg,#f7f7ff,#ffffff);
border:1px solid #ddd;
box-shadow:0 3px 12px rgba(0,0,0,.08);
">
    <div style="font-size:21px;font-weight:700;">
        ✨ Rky Connect
    </div>
    <div style="font-size:13px;color:#777;margin-top:4px;">
        Build your own Rky Circle
    </div>
</div>

<div id="rkyConnectBox"
style="
display:none;
margin:8px 0 12px;
padding:14px;
border-radius:16px;
background:#fff;
border:1px solid #e1e1e1;
box-shadow:0 2px 8px rgba(0,0,0,.06);
">

    <div style="font-size:14px;font-weight:600;margin-bottom:8px;">
        🔎 Find someone on Rky
    </div>

    <div style="
    display:flex;
    gap:7px;
    align-items:center;
    ">

        <input
          id="friendUsername"
          type="text"
          placeholder="Enter username"
          style="
          flex:1;
          min-width:0;
          padding:11px 13px;
          border:1px solid #ccc;
          border-radius:12px;
          outline:none;
          box-sizing:border-box;
          ">

        <button
          type="button"
          onclick="sendFriendRequest()"
          style="
          padding:11px 14px;
          border:none;
          border-radius:12px;
          cursor:pointer;
          font-weight:600;
          ">
          ✨ Connect
        </button>

    </div>

    <div style="
    margin-top:9px;
    font-size:12px;
    color:#888;
    ">
        Send a connection request and start your Rky Circle.
    </div>

</div>



<button
  id="rkyCircleRequestsToggle"
  type="button"
  onclick="toggleRkyCircleRequests()"
  style="
  width:100%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin:12px 0 8px;
  padding:12px 14px;
  border:1px solid #e5e5ee;
  border-radius:14px;
  background:linear-gradient(135deg,#ffffff,#f8f7ff);
  cursor:pointer;
  font-size:15px;
  font-weight:700;
  text-align:left;
  box-sizing:border-box;
  ">
  <span style="display:flex;align-items:center;gap:8px;">
    <span>📨 Rky Circle Requests</span>
    <span
      id="friendRequestBadge"
      style="
        display:none;
        min-width:20px;
        height:20px;
        padding:0 6px;
        border-radius:10px;
        background:#e53935;
        color:#fff;
        font-size:11px;
        font-weight:700;
        line-height:20px;
        text-align:center;
        box-sizing:border-box;
      "
    ></span>
  </span>
  <span id="rkyCircleRequestsArrow">›</span>
</button>

<div id="rkyCircleRequestsContent" style="display:none;">

<div id="requestList">
    <p style="font-size:13px;color:#888;">
        No new connection requests.
    </p>
</div>

</div>

<button
  onclick="loadRequests()"
  type="button"
  style="
  margin-top:8px;
  padding:8px 12px;
  border:1px solid #ddd;
  border-radius:10px;
  background:#fff;
  cursor:pointer;
  ">
  🔄 Refresh
</button>

<!-- 📤 Sent Rky Circle Requests -->
<div id="rkySentRequestsSection"
style="
margin:14px 0 10px;
padding:14px;
border:1px solid #e5e5ee;
border-radius:16px;
background:linear-gradient(135deg,#ffffff,#faf9ff);
box-shadow:0 3px 10px rgba(0,0,0,.06);
">

    <div style="
        display:flex;
        align-items:center;
        justify-content:space-between;
        margin-bottom:10px;
    ">
        <div>
            <div style="font-size:16px;font-weight:700;">
                📤 Sent Requests
            </div>
            <div style="font-size:12px;color:#888;margin-top:3px;">
                Requests you have sent
            </div>
        </div>

        <button
          type="button"
          onclick="loadSentFriendRequests()"
          style="
          padding:7px 9px;
          border:1px solid #ddd;
          border-radius:10px;
          background:#fff;
          cursor:pointer;
          ">
          ↻
        </button>
    </div>

    <div id="sentRequestList">
        <div style="
            font-size:13px;
            color:#999;
            text-align:center;
            padding:10px;
        ">
            No pending sent requests.
        </div>
    </div>

</div>

<!-- 👥 Your Rky Connections -->
<div id="rkyConnectionsSection"
style="
margin:14px 0 10px;
padding:14px;
border:1px solid #e5e5ee;
border-radius:16px;
background:linear-gradient(135deg,#ffffff,#faf9ff);
box-shadow:0 3px 10px rgba(0,0,0,.06);
">

    <div style="
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:10px;
    ">
        <div>
            <div style="font-size:16px;font-weight:700;">
                👥 Your Rky Connections
            </div>
            <div style="font-size:12px;color:#888;margin-top:3px;">
                People in your Rky Circle
            </div>
        </div>

        <button
          type="button"
          onclick="loadRkyConnections()"
          style="
          padding:7px 9px;
          border:1px solid #ddd;
          border-radius:10px;
          background:#fff;
          cursor:pointer;
          ">
          ↻
        </button>
    </div>

    <div id="rkyConnectionsList">
        <div style="font-size:13px;color:#999;text-align:center;padding:10px;">
            Loading your Rky Circle...
        </div>
    </div>






</div>

<input id="searchMessage"
type="text"

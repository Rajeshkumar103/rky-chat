async function loadRkyConnections(){

    const list = document.getElementById("rkyConnectionsList");

    if(!list || !currentUser){
        return;
    }

    list.innerHTML =
        '<div style="font-size:13px;color:#999;text-align:center;padding:10px;">Loading...</div>';

    try{
        const response = await fetch(
            "/api/friends/" +
            encodeURIComponent(currentUser) +
            "?t=" + Date.now()
        );

        if(!response.ok){
            throw new Error("HTTP " + response.status);
        }

        const data = await response.json();

        if(!data.success){
            throw new Error(data.message || "Could not load connections");
        }

        const friends = Array.isArray(data.friends)
            ? data.friends
            : [];

        if(friends.length === 0){
            list.innerHTML =
                '<div style="font-size:13px;color:#999;text-align:center;padding:10px;">' +
                'No people in your Rky Circle yet.' +
                '</div>';
            return;
        }

        list.innerHTML = "";

        friends.forEach(function(friend){

            const button = document.createElement("button");
            button.type = "button";

            const profileName =
                friend.profileName || friend.username;

            const photo =
                friend.photo ||
                "https://via.placeholder.com/50";

            let statusHTML = "";

            if(friend.status === "Online"){
                statusHTML =
                    "<span style='color:green;'>🟢 Online</span>";
            }else{
                statusHTML =
                    "<span style='color:red;'>🔴 Offline</span>";

                if(friend.lastSeen){
                    statusHTML +=
                        "<br><small>Last Seen: " +
                        escapeHTML(friend.lastSeen) +
                        "</small>";
                }
            }

            button.innerHTML =
                "<div style='display:flex;align-items:center;gap:10px;text-align:left;'>" +

                "<img src='" +
                escapeHTML(photo) +
                "' width='50' height='50' " +
                "style='border-radius:50%;object-fit:cover;flex-shrink:0;'>" +

                "<div style='min-width:0;'>" +

                "<div style='font-weight:700;font-size:16px;'>" +
                escapeHTML(profileName) +
                "</div>" +

                "<div style='font-size:12px;margin-top:3px;'>" +
                statusHTML +
                "</div>" +

                "</div>" +

                "</div>";

            button.style.display = "block";
            button.style.width = "100%";
            button.style.margin = "5px 0";
            button.style.padding = "10px";
            button.style.border = "1px solid #ddd";
            button.style.borderRadius = "12px";
            button.style.background = "#fff";
            button.style.cursor = "pointer";
            button.style.boxSizing = "border-box";

            button.onclick = function(){
                selectFriend(friend.username);
            };

            list.appendChild(button);
        });

    }catch(error){

        console.error(
            "loadRkyConnections error:",
            error
        );

        list.innerHTML =
            '<div style="font-size:13px;color:#d33;text-align:center;padding:10px;">' +
            'Could not load your Rky Circle.' +
            '</div>';
    }
}

